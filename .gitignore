# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/

# Datasets & checkpoints (large binary artifacts, never committed)
data/
checkpoints/
*.pt
*.pth
*.ckpt

# Logs
*.log
logs/

# Local API test image generated by scripts/make_test_image.py
test_image.png

# Environment / secrets
.env
.env.*
*.pem
*.key
secrets/
!k8s/*secret*.yaml.example

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Kubernetes local kubeconfig dumps
kubeconfig*.yaml

# Coverage
.coverage
htmlcov/
